  "main": "index.js",
  "scripts": {
    "dev:server": "tsx src/server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.cjs --packages=external",
    "build:client": "vite build --config vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "start:server": "node dist/server.cjs",
    "start:client": "vite preview --config vite.config.ts",
    "test": "vitest run",
    "lint:i18n": "node scripts/check-hardcoded-strings.mjs",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "kit:start": "node scripts/kit-start.mjs",
    "kit:start:legacy": "node scripts/setup-mcp.mjs && node scripts/setup-gateway.mjs",
    "kit:start:mcp": "node scripts/setup-mcp.mjs",
    "kit:start:gateway": "node scripts/setup-gateway.mjs",
    "kit:health": "node scripts/orchestrator-health-check.mjs",
    "kit:status": "node scripts/kit-status.mjs",
    "kit:stop": "node scripts/kit-stop.mjs",
    "kit:stop:legacy": "node -e \"const fs=require('fs');const p=fs.readFileSync('.mcp-server.pid','utf8').trim();try{process.kill(+p)}catch(e){};fs.unlinkSync('.mcp-server.pid')\" 2>/dev/null || echo 'MCP not running'",
    "lifecycle:generate": "tsx scripts/generate-project-lifecycle.ts",
    "devplan:generate": "tsx scripts/generate-project-devplan.ts",
    "watermark": "node scripts/watermark.mjs",
    "check:getting-started": "node scripts/check-getting-started-sync.mjs",
    "test:e2e": "playwright test"
  },
