# wxKanban Environment Configuration
# Copy this file to .env and fill in actual values

# Server Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/wxkanban

# MCP Central Database (wxKanban specs/lifecycle/reference)
# This may differ from the app DATABASE_URL above.
WXKANBAN_MCP_DATABASE_URL=postgresql://user:password@localhost:5432/wxkanban
WXKANBAN_API_TOKEN=wxk_live_your_api_token_here
API_KEY=your-mcp-api-key
MCP_HTTP_PORT=3002

# Authentication
JWT_SECRET=your-secret-key-min-32-characters-long-required
ENCRYPTION_KEY=your-encryption-key-min-32-characters-long-required
# Required: exactly 32 UTF-8 chars. Encrypts company settings at rest. Generate with: openssl rand -base64 24 | head -c 32
SETTINGS_ENCRYPTION_KEY=

# Client
CLIENT_URL=http://localhost:3000

# PM System OAuth Credentials

# Jira (Atlassian OAuth 2.0 3LO) — create an app at
# https://developer.atlassian.com/console/myapps/
# Steps:
#   1. Sign in with the Atlassian account that owns the target Jira Cloud site.
#   2. Click "Create" → "OAuth 2.0 integration" → name it (e.g., "wxKanban Dev").
#   3. In the app's left sidebar open "Permissions" and add the "Jira API".
#      Click "Configure" next to Jira API and enable these scopes (must match
#      src/server/lib/pm-adapters/jira.ts createJiraAdapter()):
#        read:jira-work, read:jira-user, write:jira-work, offline_access
#   4. Open "Authorization" in the sidebar, click "Configure" on "OAuth 2.0 (3LO)"
#      and set the Callback URL to:
#        http://localhost:5173/oauth/callback/jira
#      (5173 is the Vite dev port set in vite.config.ts; add your production URL
#      later, e.g. https://app.example.com/oauth/callback/jira)
#   5. Open "Settings" in the sidebar. Copy "Client ID" → JIRA_CLIENT_ID and
#      "Secret" → JIRA_CLIENT_SECRET below.
#   6. Keep the callback URL in sync with JIRA_REDIRECT_URI.
#   7. Jira's 3LO flow returns tokens against api.atlassian.com; the adapter
#      resolves the user's specific Cloud site (cloudid) on first task fetch.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:5173/oauth/callback/jira

# Monday.com OAuth — create an app at https://monday.com/developers/apps
# Steps:
#   1. Sign in to monday.com and open the Developer Center (top-right avatar → Developers).
#   2. Click "Create app" → give it a name (e.g., "wxKanban Dev").
#   3. In the app's left sidebar open "OAuth & Permissions".
#   4. Under "Redirect URLs" add:  http://localhost:5173/oauth/callback/monday
#      (5173 is the Vite dev port set in vite.config.ts)
#      (add your production URL later, e.g. https://app.example.com/oauth/callback/monday)
#   5. Under "Scopes" enable at least:
#        me:read, boards:read, boards:write, users:read, account:read
#      (must match the scopes in src/server/lib/pm-adapters/monday.ts createMondayAdapter())
#   6. Copy the "Client ID" and "Client Secret" from the app's "Basic Information" page
#      into MONDAY_CLIENT_ID / MONDAY_CLIENT_SECRET below.
#   7. Keep the redirect URI here in sync with MONDAY_REDIRECT_URI.
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=http://localhost:3000/oauth/callback/monday

# Asana OAuth 2.0 — create an app at https://app.asana.com/0/my-apps
# Steps:
#   1. Sign in to Asana → click "+ Create new app" (or open an existing one).
#      Give it a name (e.g., "wxKanban Dev") and accept the API terms.
#   2. On the app page, open the "OAuth" section (left sidebar or tab).
#   3. Under "Redirect URLs" add:
#        http://localhost:5173/oauth/callback/asana
#      (5173 is the Vite dev port set in vite.config.ts; add your production URL
#      later, e.g. https://app.example.com/oauth/callback/asana)
#   4. Under "Permission scopes" select either:
#        - "Full permissions" (default; grants read/write to the user's data), or
#        - Explicit scopes: default, tasks:read, tasks:write, projects:read,
#          users:read  (must match the scopes the Asana adapter requests).
#   5. Copy "Client ID" → ASANA_CLIENT_ID and "Client secret" → ASANA_CLIENT_SECRET.
#   6. Keep the redirect URL in sync with ASANA_REDIRECT_URI.
#   7. Asana issues short-lived access tokens (~1 hour) with refresh tokens — the
#      adapter must call /-/oauth_token with grant_type=refresh_token before expiry.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=http://localhost:5173/oauth/callback/asana

# Trello — uses a simple token flow (NOT OAuth 2.0). No "OAuth app" to create.
# Steps:
#   1. Log in to Trello and open https://trello.com/app-key
#   2. Copy the "API Key" at the top of the page into TRELLO_API_KEY below
#      (this key is considered public — it is shown in the browser-side redirect URL).
#   3. The "Secret" on that page is for OAuth 1.0a server signing. Not required
#      for the token flow used here, but copy it into TRELLO_API_SECRET anyway
#      in case a future feature needs it.
#   4. Trello does NOT require pre-registering a redirect URL. The return_url
#      is passed at authorize time and must match TRELLO_REDIRECT_URI.
#   5. IMPORTANT: Trello returns the token in the URL **fragment** (#token=...)
#      rather than a query param, so the OAuth callback page must read
#      window.location.hash — not window.location.search — for Trello.
#   6. Scopes requested: read, write  (set in the adapter's getAuthorizationUrl).
#   7. Expiration: "never" (Trello tokens do not expire unless revoked).
TRELLO_API_KEY=ecce401a4629620e2fed035ac1afc4fc
TRELLO_API_SECRET=
TRELLO_REDIRECT_URI=http://localhost:5173/oauth/callback/trello

# AI APIs
# Spec 025 FR-019 + Spec 019 R6 — provider selection.
# Default: groq + llama-3.3-70b-versatile (free tier, fast SSE streaming),
# good for conversational surfaces (BA interview, proposal drafting).
# Set LLM_PROVIDER to one of: groq | gemini | anthropic
LLM_PROVIDER=groq

# Per-handler override (Spec 019 R6 AC 9): `LLM_PROVIDER_<HANDLER>` overrides
# LLM_PROVIDER for that handler only. Use this to route code-emitting handlers
# (implement, createspecs) to a higher-quality paid model while keeping
# low-stakes conversational handlers on the free default. Handler names are
# the uppercase command id (IMPLEMENT, CREATESPECS, BUILDSCOPE, RUNQA,
# RUNHUMAN, PREPARERELEASE, FINALIZERELEASE).
# Example: LLM_PROVIDER_IMPLEMENT=anthropic
#LLM_PROVIDER_IMPLEMENT=anthropic
#LLM_PROVIDER_CREATESPECS=anthropic

# Groq (default) — sign up at https://console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (fallback, free tier 1500 req/day) — Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (paid fallback, highest quality for structured docs / code-gen)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# [SCOPE 025 / FR-020 + FR-021] Project Overview BA interview — sliding transcript
# window sent to the LLM per turn (full transcript is still persisted). Default
# raised 10 -> 28 so a full seven-section interview (~4 turns/section) stays in
# context; too small a window makes the model lose its place and restart at the
# Problem section. Override only to trade context depth for per-turn token cost.
#OVERVIEW_HISTORY_TURNS=28

# [SCOPE 065 / T008] Marketing AI Assist — overrides the app-wide LLM_PROVIDER for
# marketing-copy generation only (newsletter/social/SEO/translate/repurpose/analyze).
# Defaults to Claude for copy quality; falls back to the app default if no key.
# Requires ANTHROPIC_API_KEY above. Set these in the App Runner console for prod.
MARKETING_LLM_PROVIDER=anthropic
MARKETING_LLM_MODEL=claude-sonnet-4-6
# Soft per-user/per-action throttle window (ms) for AI assist endpoints.
# [SCOPE 066] The FAQ "Generate default FAQs" seed reuses this same marketing-AI
# config (MARKETING_LLM_PROVIDER/MODEL + ANTHROPIC_API_KEY) and throttle — no new vars.
#MARKETING_AI_THROTTLE_MS=4000

OPENAI_API_KEY=

# Email Service (generic SMTP via nodemailer)
# Leave SMTP_HOST unset in dev to log emails to Pino instead of sending.
# Examples:
#   Mailtrap (dev sandbox):   SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525
#   Resend:                   SMTP_HOST=smtp.resend.com           SMTP_PORT=587  SMTP_USER=resend
#   Gmail (app password):     SMTP_HOST=smtp.gmail.com            SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=wxKanban <noreply@example.com>

# Stripe (set false during main testing to pause all credit-card processing)
STRIPE_CC_PROCESSING_ENABLED=false
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SMALL_BUSINESS=
STRIPE_PRICE_CONSULTANT=
STRIPE_PRICE_ENTERPRISE=

# Optional: Test Credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=TestPassword123!
TEST_CLIENT_EMAIL=user@example.com
TEST_CLIENT_PASSWORD=TestPassword123!

# ─── Marketing Newsletter (SCOPE-064 / Phase B) ──────────────────────────────
# Server-side SES newsletter send. The sender identity MUST be SES-verified and
# the AWS account out of the SES sandbox; the App Runner instance role needs the
# ses:SendEmail action added (today it only grants S3 presign). Region reuses
# MARKETING_ASSETS_REGION / AWS_REGION (default us-east-1).
NEWSLETTER_FROM=andy@wxperts.com
# HMAC secret for signing public unsubscribe links (?u=<contactid>&sig=<hmac>).
NEWSLETTER_UNSUBSCRIBE_SECRET=
# Optional: public origin hosting the unsubscribe route (defaults to CLIENT_URL).
NEWSLETTER_PUBLIC_BASE_URL=
# Optional: per-recipient send delay in ms (default 300 ≈ 3/sec, under SES limits).
NEWSLETTER_SEND_DELAY_MS=300

# ─── Banner Studio (SCOPE-070) ───────────────────────────────────────────────
# AI image generation for banner backgrounds. Default reuses GEMINI_API_KEY above
# (Imagen via the same Google Generative Language API as Gemini text) — no new vendor.
# Set GEMINI_API_KEY in the App Runner console for prod. Flip IMAGE_PROVIDER to
# openai-gpt-image later (needs OPENAI_API_KEY) — not implemented in Phase 1.
IMAGE_PROVIDER=gemini-imagen
# Imagen 4 (v3 is not exposed on the Gemini API project; v4 is). Requires the key's
# Google project to be on the PAID plan (free tier returns 400 "paid plans only").
# Use imagen-4.0-fast-generate-001 for cheaper/faster, -ultra- for best quality.
IMAGE_MODEL=imagen-4.0-generate-001
# Logo composited onto banners (loaded over the network at render time).
BANNER_LOGO_URL=https://windev.wxperts.com/wxKanbanLight.png
# Rendered PNGs + backgrounds reuse the marketing-assets S3 bucket / CloudFront
# (MARKETING_ASSETS_BUCKET / MARKETING_ASSETS_REGION / MARKETING_ASSETS_BASEURL).
#
# Tracked links (/r/:code). REDIRECT_BASE_URL is the app origin used to build the
# absolute /r/:code URL for export snippets + on-site embeds. BANNER_LINK_ALLOWED_HOSTS
# is a comma-separated allowlist of destination hosts (defense-in-depth; default covers
# wxkanban.com / wxperts.com / windev.wxperts.com). The redirect itself is open-redirect
# -proof regardless (it only ever sends to the stored destination).
REDIRECT_BASE_URL=https://wxkanban.com
#BANNER_LINK_ALLOWED_HOSTS=wxkanban.com,www.wxkanban.com,wxperts.com,windev.wxperts.com
# Salt for the per-click IP hash (salted + truncated, no raw IP stored). Set a long
# random value in the App Runner console for prod; a default is used if unset.
IPHASH_SALT=

# ---------------------------------------------------------------------------
# YappChatt — Remote Session Bridge (SCOPE-102)
# ---------------------------------------------------------------------------
# Drive this project's Claude session from your phone through a private YappChatt
# room. Say "GO REMOTE" (or /remote) in the session; the bridge connects,
# announces itself, and stays idle until a room message arrives.
#
# The five YAPPCHATT_* vars below are everything needed to connect and chat.
#
# TWO IDENTITIES, and this is the part that catches people out:
#   * YAPPCHATT_TOKEN writes — the per-room agent token, posts as "Claude".
#   * YAPPCHATT_EMAIL reads  — mints the broker session for inbound control.
# The agent token CANNOT read history or subscribe. Set only the token and you get
# a bridge that posts and then goes deaf: it looks connected and never answers.
# Both are required.
#
# Older WXKANBAN_-prefixed spellings (and the one-T YAPPCHAT_ forms) are still
# accepted as deprecated fallbacks; the config resolver reports which stale names
# an .env is relying on, so upgrading is visible rather than silent.

# Private room conversationId. Provision the room in YappChatt first.
YAPPCHATT_ROOM=
# WRITE identity. YappChatt web app -> open the room -> "Connect Claude" -> copy.
# Per-room and revocable, so a leak is contained to one room.
YAPPCHATT_TOKEN=
# READ identity — mints the session used for steering and push approval.
YAPPCHATT_EMAIL=
# Display name for that read session. Defaults to the email when unset.
#YAPPCHATT_DISPLAY_NAME=
# Endpoints — leave unset to use the hosted defaults.
#YAPPCHATT_URL=https://www.yappchatt.com
#YAPPCHATT_WS_URL=wss://ws.wxperts.com

# Bridge behaviour — these stay WXKANBAN_-prefixed; they configure wxKanban's
# bridge rather than the YappChatt connection.
#
# LEAVE WXKANBAN_REMOTE_SEED EMPTY. A directive seed spawns a second autonomous
# Claude that edits files on the same working tree as your live session.
#WXKANBAN_REMOTE_SEED=
#WXKANBAN_REMOTE_MODEL=
#WXKANBAN_REMOTE_RESUME=
#WXKANBAN_PROJECT_NAME=
#WXKANBAN_APP_BASE_URL=https://wxkanban.wxperts.com
