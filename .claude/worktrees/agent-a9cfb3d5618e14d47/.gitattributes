# Line-ending normalization.
# The kit is authored on Windows but must run on macOS/Linux. A CRLF shebang
# (#!/usr/bin/env node\r) fails on Unix with "env: node\r: No such file or
# directory", which is why the orchestrator CLI / kit scripts didn't run on Mac.
# Default every text file to LF; keep Windows-only scripts CRLF; never touch binaries.
* text=auto eol=lf

# Executable / source scripts — always LF
*.mjs   text eol=lf
*.cjs   text eol=lf
*.js    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sh    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows-only scripts keep CRLF
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Binary assets — never normalize
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.vsix  binary
*.tgz   binary
*.gz    binary
*.zip   binary
*.woff  binary
*.woff2 binary

# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads
