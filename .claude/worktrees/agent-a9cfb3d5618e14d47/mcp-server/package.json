{
  "name": "mcp-project-hub",
  "version": "0.1.1",
  "description": "MCP server for wxKanban project management integration",
  "type": "module",
  "main": "dist/index-http.js",
  "scripts": {
    "prebuild": "node scripts/build-prompts.mjs",
    "build": "tsc -b --force",
    "postbuild": "esbuild ../wxkanban-agent/core/policy/adapters/mcp-adapter.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/_kit/mcp-adapter.cjs --external:pg && esbuild ../wxkanban-agent/core/stage/scope-stage.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/_kit/scope-stage.cjs --external:pg",
    "start": "node start-http.mjs",
    "dev": "tsx watch src/index-http.ts",
    "test": "vitest",
    "test:integration": "vitest run tests/integration/",
    "lint": "eslint src/",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit up:pg"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@wxkanban/preflight": "file:../shared/preflight",
    "@wxkanban/watermark": "file:../shared/watermark",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "eventsource": "^2.0.2",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.56.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@hono/node-server": "^2.0.5"
  }
}
