# Database connection
DATABASE_URL=postgresql://username:password@localhost:5432/wxkanban

# API key for MCP server authentication
API_KEY=your-secure-api-key-here

# Transport mode: stdio (default) or http
TRANSPORT=stdio

# HTTP port (only used if TRANSPORT=http)
HTTP_PORT=3000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# [SCOPE 074] Capability index embeddings (separate from LLM_PROVIDER — embeddings ≠ generation)
# Provider: gemini (default) | openai | selfhosted (OpenAI-compatible /v1/embeddings, bring-your-own / SCOPE-076)
EMBEDDINGS_PROVIDER=gemini
# Model (default gemini-embedding-001; text-embedding-004 is retired -> 404). Output truncated
# to EMBEDDINGS_DIM via Matryoshka so it matches the capabilityindex vector(N).
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768
# Required for EMBEDDINGS_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
# For openai/selfhosted only:
# EMBEDDINGS_BASE_URL=http://customer-host:11434/v1
# EMBEDDINGS_API_KEY=optional-bearer-for-selfhosted
