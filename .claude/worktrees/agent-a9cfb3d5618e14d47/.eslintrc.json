{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["error"]
      }
    ],
    "no-unused-vars": "off",
    "indent": ["error", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"]
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "build",
    ".vite",
    "*.json",
    "_wxAI-global",
    "_wxAI-project",
    "_cpl",
    "tailwind.config.js"
  ]
}
