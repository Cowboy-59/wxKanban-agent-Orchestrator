{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'wxKanban Orchestrator ready. Commands by stage: wxkanban-agent --help (slash commands: wxkanban-agent --list-slash).'",
            "timeout": 5,
            "statusMessage": "Starting wxKanban orchestrator..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/forward-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/impact/hook.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking change impact..."
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/hook-settings-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/capture-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/capture-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/capture-hook.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/_wxAI/routing/forward-hook.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
