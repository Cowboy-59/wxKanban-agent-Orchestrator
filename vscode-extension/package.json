{
  "name": "wxkanban-dev-cockpit",
  "displayName": "wxKanban Dev Cockpit",
  "description": "See the current wxKanban project's remaining work per scope, without leaving the editor.",
  "version": "0.2.9",
  "publisher": "wxperts",
  "icon": "media/wxPerts_icon.png",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.wxkanban-project.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wxkanban",
          "title": "wxKanban",
          "icon": "media/cockpit.svg"
        }
      ]
    },
    "views": {
      "wxkanban": [
        {
          "id": "wxkanban.cockpit",
          "name": "Dev Cockpit",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "wxkanban.cockpit.refresh",
        "title": "wxKanban: Refresh Cockpit",
        "icon": "$(refresh)"
      },
      {
        "command": "wxkanban.cockpit.openSpec",
        "title": "wxKanban: Open Related Spec / File"
      },
      {
        "command": "wxkanban.cockpit.signIn",
        "title": "wxKanban: Sign In / Relink Project"
      },
      {
        "command": "wxkanban.cockpit.submitFeedback",
        "title": "wxKanban: Report a Bug / Suggest a Feature",
        "icon": "$(comment)"
      },
      {
        "command": "wxkanban.cockpit.myFeedback",
        "title": "wxKanban: My Feedback"
      },
      {
        "command": "wxkanban.cockpit.checkoutScope",
        "title": "wxKanban: Check Out Scope",
        "icon": "$(git-branch)"
      },
      {
        "command": "wxkanban.cockpit.checkinScope",
        "title": "wxKanban: Check In Scope",
        "icon": "$(check)"
      },
      {
        "command": "wxkanban.cockpit.installCommands",
        "title": "wxKanban: Install Slash Commands (.claude/commands)",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wxkanban.cockpit.submitFeedback",
          "when": "view == wxkanban.cockpit",
          "group": "navigation"
        },
        {
          "command": "wxkanban.cockpit.refresh",
          "when": "view == wxkanban.cockpit",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "wxkanban.cockpit.openSpec",
          "when": "view == wxkanban.cockpit && viewItem =~ /^wxkanban\\.scope/",
          "group": "inline"
        },
        {
          "command": "wxkanban.cockpit.checkoutScope",
          "when": "view == wxkanban.cockpit && (viewItem == wxkanban.scope.free || viewItem == wxkanban.scope.held)",
          "group": "1_wxkanban@1"
        },
        {
          "command": "wxkanban.cockpit.checkinScope",
          "when": "view == wxkanban.cockpit && (viewItem == wxkanban.scope.mine || viewItem == wxkanban.scope.held)",
          "group": "1_wxkanban@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "package": "node esbuild.mjs && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
