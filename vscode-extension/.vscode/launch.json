{
  // [SCOPE 066 / T008] Run the built Dev Cockpit extension against the LOCAL app
  // server so the new FAQ + Open/Training video sections show local data.
  // Open the `vscode-extension` folder in VS Code and press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Cockpit (local app server)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "env": {
        "WXKANBAN_DOCS_BASE_URL": "http://localhost:3001"
      }
    }
  ]
}
